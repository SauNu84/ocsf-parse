{
  "source_name": "vpc_flow_logs",
  "parser": {
    "regex": "^(?P<version>\\d+) (?P<account_id>\\d+) (?P<interface_id>\\S+) (?P<srcaddr>\\S+) (?P<dstaddr>\\S+) (?P<srcport>\\d+|-) (?P<dstport>\\d+|-) (?P<protocol>\\d+|-) (?P<packets>\\d+) (?P<bytes>\\d+) (?P<start>\\d+) (?P<end>\\d+) (?P<action>\\S+) (?P<log_status>\\S+)$",
    "groups": ["version","account_id","interface_id","srcaddr","dstaddr","srcport","dstport","protocol","packets","bytes","start","end","action","log_status"]
  },
  "routing": {
    "field": "$.action",
    "rules": [
      { "matches": ["ACCEPT", "REJECT"], "class": "network_activity" },
      { "default": true, "class": "network_activity" }
    ]
  },
  "classes": {
    "network_activity": {
      "mapping": {
        "metadata.version":             { "const": "1.9.0-dev" },
        "metadata.product.name":        { "const": "Amazon VPC Flow Logs" },
        "metadata.product.vendor_name": { "const": "AWS" },
        "metadata.product.feature.name":{ "const": "VPC Flow Logs" },
        "metadata.logged_time":         { "time": "$.end", "format": "epoch_s" },
        "time":                         { "time": "$.start", "format": "epoch_s" },
        "category_uid":                 { "const": 4 },
        "category_name":                { "const": "Network Activity" },
        "class_uid":                    { "const": 4001 },
        "class_name":                   { "const": "Network Activity" },
        "activity_id":                  { "const": 6 },
        "activity_name":                { "const": "Traffic" },
        "type_uid":                     { "expr": "class_uid * 100 + activity_id" },
        "severity_id":                  { "lookup": "$.action", "table": {"ACCEPT": 1, "REJECT": 3}, "default": 1 },
        "severity":                     { "lookup": "$.action", "table": {"ACCEPT": "Informational", "REJECT": "Medium"}, "default": "Informational" },
        "status_id":                    { "lookup": "$.action", "table": {"ACCEPT": 1, "REJECT": 2}, "default": 0 },
        "status":                       { "lookup": "$.action", "table": {"ACCEPT": "Success", "REJECT": "Failure"}, "default": "Unknown" },
        "src_endpoint.ip":              { "path": "$.srcaddr" },
        "src_endpoint.port":            { "int": "$.srcport" },
        "src_endpoint.interface_uid":   { "path": "$.interface_id" },
        "dst_endpoint.ip":              { "path": "$.dstaddr" },
        "dst_endpoint.port":            { "int": "$.dstport" },
        "connection_info.protocol_num": { "int": "$.protocol" },
        "connection_info.protocol_name":{ "lookup": "$.protocol", "table": {"6": "TCP", "17": "UDP", "1": "ICMP", "47": "GRE", "50": "ESP"}, "default": "Other" },
        "connection_info.direction":    { "const": "Outbound" },
        "connection_info.direction_id": { "const": 2 },
        "traffic.bytes":                { "int": "$.bytes" },
        "traffic.packets":              { "int": "$.packets" },
        "cloud.provider":               { "const": "AWS" },
        "cloud.account.uid":            { "path": "$.account_id" },
        "disposition_id":               { "lookup": "$.action", "table": {"ACCEPT": 1, "REJECT": 2}, "default": 0 },
        "disposition":                  { "lookup": "$.action", "table": {"ACCEPT": "Allowed", "REJECT": "Blocked"}, "default": "Unknown" },
        "raw_data":                     { "raw": true }
      }
    }
  }
}
